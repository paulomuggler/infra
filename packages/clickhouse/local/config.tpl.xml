<?xml version="1.0"?>
<clickhouse>
    <!-- this is undocumented but needed to enable waiting for for shutdown for a custom amount of time  -->
    <!-- see https://github.com/ClickHouse/ClickHouse/pull/77515 for more details  -->
    <shutdown_wait_unfinished>60</shutdown_wait_unfinished>
    <shutdown_wait_unfinished_queries>1</shutdown_wait_unfinished_queries>

    <!-- Use up 80% of available RAM to be on the safer side, default is 90% -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

    <default_replica_path>/var/lib/clickhouse/tables/{shard}/{database}/{table}</default_replica_path>

    <remote_servers replace="true">
        <cluster>
            <shard>
                <replica>
                    <host>localhost</host>
                    <port>${PORT}</port>
                    <user>${USERNAME}</user>
                    <password>${PASSWORD}</password>
                </replica>
            </shard>
        </cluster>
    </remote_servers>

    <listen_host>0.0.0.0</listen_host>

    <tcp_port>${PORT}</tcp_port>
    <!-- Bound ClickHouse's own system logs: they grow unbounded by default
         (reached 8G here before TTLs were added 2026-07-14). Config ttl applies
         when tables are created (fresh volume); the live tables carry the same
         TTL via ALTER. -->
    <query_log><ttl>event_date + INTERVAL 15 DAY DELETE</ttl></query_log>
    <trace_log><ttl>event_date + INTERVAL 15 DAY DELETE</ttl></trace_log>
    <text_log><ttl>event_date + INTERVAL 15 DAY DELETE</ttl></text_log>
    <metric_log><ttl>event_date + INTERVAL 15 DAY DELETE</ttl></metric_log>
    <asynchronous_metric_log><ttl>event_date + INTERVAL 15 DAY DELETE</ttl></asynchronous_metric_log>
    <latency_log><ttl>event_date + INTERVAL 15 DAY DELETE</ttl></latency_log>
    <part_log><ttl>event_date + INTERVAL 15 DAY DELETE</ttl></part_log>
    <query_views_log><ttl>event_date + INTERVAL 15 DAY DELETE</ttl></query_views_log>
</clickhouse>